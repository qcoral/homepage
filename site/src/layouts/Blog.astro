---
import Layout from "../layouts/Layout.astro";
import Navigator from "../components/Navigator.astro";
// this should only contain text + a back button to go back to normalcy
---

<Layout>
    <div class="lg:fixed mb-4">
        <Navigator />
    </div>
    <div
        class="pt-8 prose-hr:my-0 bg-noise prose prose-invert max-w-xl lg:max-w-3xl 2xl:max-w-4xl mx-auto bg-gray-900/25 p-4 md:p-6 rounded-lg border-2 border-gray-600"
    >
        <slot />
    </div>
</Layout>
