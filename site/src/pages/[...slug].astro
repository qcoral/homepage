---
import Blog from "../layouts/Blog.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const pages = await getCollection("pages");
    return pages.map((page) => ({
        params: { slug: page.slug },
        props: { page },
    }));
}

const { page } = Astro.props;

const title = page.data.title ?? "title not found";
const isDraft = page.data.draft ?? false;
const { Content } = await page.render();
const description = page.data.description ?? null;
const published = page.data.published
    ? new Date(page.data.published).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
          timeZone: "UTC",
      })
    : null;

console.log("date:", published);
---

<Blog>
    <div class="text-left prose-h1:my-0 -mt-3 md:mt-2 -mb-2">
        <h1>{title}</h1>
        {description && <p>{description}</p>}
        {
            published && (
                <p>
                    <em>Published: {published}</em>
                </p>
            )
        }
    </div>
    <hr class="border-gray-600 border" />
    {
        isDraft ? (
            <p>this page is currently a WIP! check back another time</p>
        ) : (
            <Content />
        )
    }
</Blog>
