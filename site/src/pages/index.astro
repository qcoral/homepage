---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import About from "../content/about.md";
import Banner from "../components/Banner.astro";
import Commit from "../components/Commit.astro";
import Quotes from "../components/Quotes.astro";
import NowPlaying from "../components/NowPlaying.astro";
import Weather from "../components/Weather.astro";
---

<Layout>
    <div class="max-w-2xl 2xl:max-w-3xl mx-auto px-3 md:px-0">
        <Banner />
        <hr class="border-gray-600 border-2 mt-5 md:mt-8 -mb-2 md:-mb-1" />
        <div
            class="pt-0 transition-[font-size] duration-150 ease-in-out landing max-w-none"
        >
            <About />
        </div>
        <hr class="border-gray-600 border-2 mt-8 mb-6" />
        <div class="flex flex-col justify-center">
            <div
                class="flex flex-col md:flex-row space-y-4 md:space-y-0 justify-between"
            >
                <NowPlaying /><Weather />
            </div>
            <hr class="my-6 border-t border border-gray-600" />
            <Quotes />
            <Commit />
        </div>
    </div>
</Layout>
