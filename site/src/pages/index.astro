---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import About from "../content/about.md";
import Banner from "../components/Banner.astro";
import Commit from "../components/Commit.astro";
import Quotes from "../components/Quotes.astro";
---

<Layout>
  <div class="max-w-2xl 2xl:max-w-3xl mx-auto">
    <Banner />
    <hr class="border-gray-600 border-2 mt-8 -mb-1" />
    <div
      class="pt-8 prose-sm lg:prose-base transition-[font-size] duration-200 ease-out prose prose-invert max-w-none"
    >
      <About />
    </div>
    <hr class="border-gray-600 border-2 mt-8 -mb-1" />
    <div class="flex flex-col justify-center">
      <Quotes />
      <Commit />
    </div>
  </div>
</Layout>
