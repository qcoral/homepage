---
// Render a random quote from quotelist.yaml
export const prerender = false;
import { getEntry } from "astro:content";

const quotelist = await getEntry("quotelist", "quotelist");
const quotes = quotelist?.data.quotes ?? [];
const randomIndex = Math.floor(Math.random() * quotes.length);
const randomQuote = quotes[randomIndex];
---

<div class="my-4 text-center">
    <blockquote class="text-sm text-gray-400/67 mb-4 italic">
        {randomQuote.text}
    </blockquote>
    {
        randomQuote.author && (
            <cite class="text-xs text-gray-400/50 italic">
                — {randomQuote.author}
                {randomQuote.source && (
                    <span class="text-gray-400/50">
                        {" "}
                        ({randomQuote.source})
                    </span>
                )}
            </cite>
        )
    }
</div>
